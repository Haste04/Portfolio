---
import '../../styles/about.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionFrame from '../SectionFrame.astro';
import { sections } from '../../data/portfolio';
import { stories } from '../../data/about';
const images = import.meta.glob<ImageMetadata>('../../assets/about/*.jpg', { eager: true, import: 'default' });
---
<SectionFrame section={sections[1]}>
  <p slot="intro" class="section-introduction">The code is part of the story. The curiosity behind it is the rest.</p>
  <div class="story-gallery">
    {stories.map((story,index) => {
      const image = images['../../assets/about/'+story.id+'.jpg']!;
      return <div class="story-entry" data-about-entry={story.id}><article class:list={['photo-story',{'is-reversed':story.reversed}]} data-story={story.id} aria-labelledby={'story-'+story.id} style={`--photo-position:${story.position};--photo-mobile-position:${story.mobilePosition}`}>
        <div class="story-media" data-story-photo={story.photo}>
          <Image src={image} widths={[...new Set([480,800,Math.min(1200,image.width)])]} sizes="(min-width: 1440px) 740px, (min-width: 900px) 58vw, 100vw" format="webp" quality={80} width={Math.min(1200,image.width)} height={Math.round(image.height*Math.min(1200,image.width)/image.width)} alt={story.alt} loading="lazy" decoding="async" class="story-photograph" />
        </div>
        <div class="story-shade" aria-hidden="true"></div>
        <div class="story-copy">
          <p class="story-chapter"><span class="story-number">0{index+1}</span><span class="story-label">{story.label}</span></p>
          <h3 id={'story-'+story.id} class="story-title">{story.title}</h3>
          <p class="story-teaser">{story.teaser}</p>
          <p class="story-detail">{story.detail}</p>
        </div>
      </article></div>;
    })}
  </div>
  <script>
    import {initAboutSlides} from '../../scripts/about-slides/controller';
    initAboutSlides();
  </script>
</SectionFrame>
