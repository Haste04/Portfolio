---
import BaseLayout from '../layouts/BaseLayout.astro';
import branding from '../data/branding.json';
const logoUrl=branding.logo.output+'?v='+branding.logo.sha256.slice(0,12);
import FloatingNav from '../components/FloatingNav.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Education from '../components/sections/Education.astro';
import Projects from '../components/sections/Projects.astro';
import TechStack from '../components/sections/TechStack.astro';
import Experience from '../components/sections/Experience.astro';
import Contact from '../components/sections/Contact.astro';
---
<BaseLayout>
  <FloatingNav />
  <header class="page-masthead content-container">
    <span id="page-top" class="top-sentinel" aria-hidden="true"></span>
    <a class="wordmark" href="#home" aria-label="Haggai Estavilla, home"><img class="portfolio-logo" src={logoUrl} data-theme-image data-theme-dark-src={logoUrl} data-theme-light-src="/assets/brand/portfolio-logo-light.webp" width="264" height="101" alt="" /></a>
  </header>
  <main id="main-content" tabindex="-1">
    <Hero /><About /><Education /><Projects /><TechStack /><Experience /><Contact />
  </main>
</BaseLayout>
